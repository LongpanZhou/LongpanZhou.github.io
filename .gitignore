# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment variables
.env
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Summoners Rift assets - exclude all except tsx and css files
src/SummonersRift/*
!src/SummonersRift/*.tsx
!src/SummonersRift/*.css
!src/SummonersRift/*.ts
# The layout saved from the editor: riftLayoutDefault.ts imports it, so the build needs it
!src/SummonersRift/defaultLayout.json

# The League models the scene loads (public/models/rift) are committed, because the site needs them
# at run time. The much larger local model library below is not: it only feeds the layout editor.

# The local model library (layout editor inventory) lives beside the source tree,
# never in the repository or the build.
/modelviewer/
